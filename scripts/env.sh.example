# Runtime environment used for these runs on a local RTX 4090 (copy to env.sh and adapt the paths).
# Stack: Python 3.8, JAX 0.3.17 (CUDA 11.8 runtime), flax, optax, mujoco-py 2.0.2.8 + MuJoCo 2.0, gym 0.24,
# metaworld commit 0875192 (the pin of the official Nevo-CRL environment.yml; see code/environment.yml).
export NEVO_ENV=/home/jerry/nevo_env                      # conda/venv prefix with the stack above
export PATH="$NEVO_ENV/bin:$PATH"

export MUJOCO_PY_MUJOCO_PATH=$HOME/.mujoco/mujoco200
export MUJOCO_PY_MJKEY_PATH=$HOME/.mujoco/mjkey.txt
# mujoco-py was built with its EGL backend (conda-forge mesalib no longer ships OSMesa). Rendering is never used.
unset MUJOCO_PY_FORCE_CPU
export MUJOCO_PY_FORCE_GPU=/usr/lib/x86_64-linux-gnu
export MUJOCO_GL=egl
export PYOPENGL_PLATFORM=egl

export CPATH="$NEVO_ENV/include${CPATH:+:$CPATH}"
export LIBRARY_PATH="$NEVO_ENV/lib${LIBRARY_PATH:+:$LIBRARY_PATH}"
export LD_LIBRARY_PATH="$MUJOCO_PY_MUJOCO_PATH/bin:$NEVO_ENV/lib:$MUJOCO_PY_FORCE_GPU${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

# XLA needs libdevice and ptxas; the conda cudatoolkit 11.8 has no ptxas, so a system CUDA toolkit (12.4 here,
# ptxas targets sm_89) is used for compilation only.
export CUDA_HOME=/usr/local/cuda-12.4
export XLA_FLAGS="--xla_gpu_cuda_data_dir=$CUDA_HOME"
export XLA_PYTHON_CLIENT_PREALLOCATE=false
export JAX_PLATFORM_NAME=gpu

export PYTHONNOUSERSITE=1
export PYTHONUNBUFFERED=1
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export TOKENIZERS_PARALLELISM=false
export WANDB_MODE=offline
